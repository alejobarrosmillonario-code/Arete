# PILAR 2: CONSENSO COGNITIVO (PRUEBA DE PRAXIS)
# =====================================================================
@dataclass
class PraxisProblem:
    problem_id: str
    description: str
    complexity_score: float
    required_energy_backing_kWh: float

class ProofOfPraxisEngine:
    """
    Motor de Consenso de Prueba de Praxis.
    Emite bloques únicamente tras certificar la resolución de cuellos de botella
    del mundo real con intervención y juicio cognitivo humano.
    """
    @staticmethod
    def generate_praxis_challenge() -> PraxisProblem:
        challenges = [
            ("OPT-LOG-8041", "Optimización dinámica de rutas de suministros médicos de emergencia", 8.5, 50.0),
            ("EDU-ADAP-102", "Evaluación e intervención pedagógica contextualizada en zona rural", 7.2, 30.0),
            ("INFRA-GRID-99", "Balance de carga en microrredes de energía distribuida ante falla regional", 9.1, 80.0)
        ]
        chosen = random.choice(challenges)
        return PraxisProblem(
            problem_id=chosen[0],
            description=chosen[1],
            complexity_score=chosen[2],
            required_energy_backing_kWh=chosen[3]
        )

    @staticmethod
    def validate_human_praxis(problem: PraxisProblem, cognitive_solution_hash: str) -> bool:
        """Verifica que la solución contenga el estándar mínimo de entropía/juicio."""
        return len(cognitive_solution_hash) == 64 and cognitive_solution_hash.startswith("00")

# =====================================================================
# PILAR 3: RESPALDO TERMODINÁMICO & LIBRO MAYOR
# =====================================================================
@dataclass
class Transaction:
    sender: str
    recipient: str
    amount_art: float
    energy_backed_kWh: float
    praxis_ref: str

@dataclass
class Block:
    index: int
    timestamp: float
    transactions: List[Transaction]
    praxis_proof: str
    energy_injected_kWh: float
    previous_hash: str
    lattice_signature: str
    hash: str = ""

    def calculate_hash(self) -> str:
        data_str = (
            f"{self.index}{self.timestamp}{json.dumps([asdict(t) for t in self.transactions])}"
            f"{self.praxis_proof}{self.energy_injected_kWh}{self.previous_hash}{self.lattice_signature}"
        )
        return hashlib.sha3_256(data_str.encode()).hexdigest()

class AreteLedger:
    """
    Libro mayor descentralizado de Areté.
    Audita el triángulo inviolable: Energía, Cuántica y Praxis.
    """
    def __init__(self):
        self.chain: List[Block] = []
        self.pending_transactions: List[Transaction] = []
        self.nodes_energy_reserve_kWh: Dict[str, float] = {}
        self.crypto = QuantumLatticeCrypto()
        self.create_genesis_block()

    def create_genesis_block(self):
        genesis_block = Block(
            index=0,
            timestamp=time.time(),
            transactions=[],
            praxis_proof="GENESIS_PRAXIS_ORIGIN",
            energy_injected_kWh=1000.0,
            previous_hash="0" * 64,
            lattice_signature="LATTICE_SIG_GENESIS"
        )
        genesis_block.hash = genesis_block.calculate_hash()
        self.chain.append(genesis_block)
        self.nodes_energy_reserve_kWh["NODE_CENTRAL_01"] = 1000.0

    def register_thermodynamic_node(self, node_id: str, energy_capacity_kWh: float):
        """Registra un nodo con capacidad física/energética real verificada."""
        self.nodes_energy_reserve_kWh[node_id] = energy_capacity_kWh
        print(f"{Colors.GREEN}[NODO REGISTRADO]{Colors.RESET} {node_id} | Reserva: {Colors.YELLOW}{energy_capacity_kWh} kWh{Colors.RESET}")

    def mint_currency(
        self, 
        node_id: str, 
        praxis_problem: PraxisProblem, 
        cognitive_solution_hash: str, 
        energy_to_inject_kWh: float
    ) -> Optional[Block]:
        """
        Emisión de moneda Areté (ART). Requiere el cumplimiento estricto de:
        1. Prueba de Praxis (Validación Cognitiva).
        2. Inyección Energética Real (Respaldo Termodinámico).
        3. Firma de Retículo en canal QKD (Seguridad Cuántica).
        """
        print(f"\n{Colors.BLUE}>>> Iniciando Proceso de Emisión de Areté (ART)...{Colors.RESET}")

        # 1. Validación de Consenso Cognitivo
        if not ProofOfPraxisEngine.validate_human_praxis(praxis_problem, cognitive_solution_hash):
            print(f"{Colors.RED}[RECHAZADO] La solución cognitiva no satisface la Prueba de Praxis.{Colors.RESET}")
            return None
        print(f"{Colors.GREEN}[1/3 CONTEXTO COGNITIVO]{Colors.RESET} Prueba de Praxis Verificada: {praxis_problem.problem_id}")

        # 2. Respaldo Termodinámico
        current_node_energy = self.nodes_energy_reserve_kWh.get(node_id, 0.0)
        if energy_to_inject_kWh > current_node_energy:
            print(f"{Colors.RED}[RECHAZADO] Energía insuficiente en los nodos de almacenamiento ({node_id}).{Colors.RESET}")
            return None
        
        # Descontar/Comprometer la energía en el sistema para respaldar la moneda
        self.nodes_energy_reserve_kWh[node_id] -= energy_to_inject_kWh
        art_minted = energy_to_inject_kWh * 1.5  # Tasa de conversión respaldada 1 kWh = 1.5 ART
        print(f"{Colors.GREEN}[2/3 TERMODINÁMICA]{Colors.RESET} {energy_to_inject_kWh} kWh inyectados -> {art_minted} ART respaldados.")

        # 3. Transmisión Cuántica QKD
        qkd_ok, qkd_msg = self.crypto.simulate_qkd_transmission(photons_count=16, intercept=False)
        print(f"{Colors.GREEN}[3/3 SEGURIDAD CUÁNTICA]{Colors.RESET} {qkd_msg}")
        
        if not qkd_ok:
            return None

        # Creación del Bloque
        reward_tx = Transaction(
            sender="SYSTEM_THERMODYNAMIC_MINT",
            recipient=node_id,
            amount_art=art_minted,
            energy_backed_kWh=energy_to_inject_kWh,
            praxis_ref=praxis_problem.problem_id
        )

        prev_block = self.chain[-1]
        priv_key, pub_key = self.crypto.generate_lattice_keys()
        
        new_block = Block(
            index=len(self.chain),
            timestamp=time.time(),
            transactions=[reward_tx] + self.pending_transactions,
            praxis_proof=cognitive_solution_hash,
            energy_injected_kWh=energy_to_inject_kWh,
            previous_hash=prev_block.hash,
            lattice_signature=hashlib.sha256(str(pub_key).encode()).hexdigest()
        )
        new_block.hash = new_block.calculate_hash()
        
        self.chain.append(new_block)
        self.pending_transactions = []
        return new_block

    def verify_chain_integrity(self) -> bool:
        """Auditoría completa de integridad del sistema Areté."""
        for i in range(1, len(self.chain)):
            current = self.chain[i]
            previous = self.chain[i - 1]

            if current.hash != current.calculate_hash():
                return False
            if current.previous_hash != previous.hash:
                return False
        return True


