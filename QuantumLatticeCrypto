# =====================================================================
# PILAR 1: SEGURIDAD FÍSICA Y CUÁNTICA (QKD + RETÍCULOS)
# =====================================================================
class QuantumLatticeCrypto:
    """
    Simulación simplificada de Criptografía Basada en Retículos (LWE)
    y Distribución Cuántica de Claves (QKD) con detección de escuchas (Eavesdropping).
    """
    def __init__(self, vector_dimension: int = 8):
        self.dim = vector_dimension

    def generate_lattice_keys(self) -> Tuple[List[int], List[int]]:
        """Genera un vector de retículo público y una clave privada."""
        private_key = [random.randint(-5, 5) for _ in range(self.dim)]
        # B en el espacio de retículo B = A*s + e
        public_key = [x * 3 + random.randint(-1, 1) for x in private_key]
        return private_key, public_key

    @staticmethod
    def simulate_qkd_transmission(photons_count: int = 16, intercept: bool = False) -> Tuple[bool, str]:
        """
        Simula la transmisión fotónica entrelazada (QKD).
        Si un tercero observa (intercept=True), el estado colapsa.
        """
        sender_bases = [random.choice(['+', 'X']) for _ in range(photons_count)]
        photons_state = [random.choice([0, 1]) for _ in range(photons_count)]
        
        receiver_bases = [random.choice(['+', 'X']) for _ in range(photons_count)]
        
        # Simulación de escucha (Eavesdropper / Eve)
        if intercept:
            eve_bases = [random.choice(['+', 'X']) for _ in range(photons_count)]
            # Al medir, Eve altera el estado fotónico cuando las bases no coinciden
            for i in range(photons_count):
                if eve_bases[i] != sender_bases[i]:
                    photons_state[i] = random.choice([0, 1])

        # Verificación del canal seguro (Sifting)
        errors = 0
        valid_bits = 0
        for i in range(photons_count):
            if sender_bases[i] == receiver_bases[i]:
                valid_bits += 1
                if intercept and random.random() > 0.5:
                    errors += 1

        if intercept or errors > 0:
            return False, f"{Colors.RED}[ALERTA QKD] Colapso de estado cuántico detectado. Intento de interceptación.{Colors.RESET}"
        return True, f"{Colors.GREEN}[CANAL QKD SEGURO] Claves fotónicas sincronizadas exitosamente.{Colors.RESET}"

